#!/bin/sh
# pre-push: これから送るコミットを Betterleaks で秘密の検査にかける。**POSIX sh で書くこと。**
# git 2.55+ の config ベース hooks（.githooks.gitconfig）から実行される。
#
# stdin は `<local ref> <local sha> <remote ref> <remote sha>` の行。
# - 削除の push（local sha が全 0）は飛ばす。
# - 新しいブランチ（remote sha が全 0）は、origin の他のブランチに無いコミットだけを見る。
# - merge commit にだけ足した内容（--diff-merges=separate）と、内容を変えない改名（--no-renames）も検査する。
# - betterleaks が無ければ警告してスキップする（CI の secret-scan が最終の砦）。
# - 規則は .betterleaks.toml。カレントディレクトリの設定は自動では読まれないため --config で渡す。
set -eu

if ! command -v betterleaks >/dev/null 2>&1; then
	echo "[pre-push] betterleaks が無いため秘密の検査をスキップします（CI の secret-scan が最終の砦）。" >&2
	exit 0
fi

# 先頭の 0 を取り除いて空なら全 0（sha-1 / sha-256 どちらでも通る）
is_zero() {
	[ -z "${1#"${1%%[!0]*}"}" ]
}

status=0
while read -r _lref lsha _rref rsha; do
	[ -n "${lsha:-}" ] || continue
	is_zero "$lsha" && continue
	if is_zero "${rsha:-0}"; then
		range="$lsha --not --remotes=origin"
	else
		range="$rsha..$lsha"
	fi
	echo "[pre-push] 秘密の検査: $range" >&2
	if ! betterleaks git . --log-opts="$range --diff-merges=separate --no-renames" --config .betterleaks.toml --redact --no-banner --log-level=warn; then
		status=1
	fi
done

if [ "$status" -ne 0 ]; then
	echo "[pre-push] 秘密の疑いがあるため push を中止します。" >&2
	exit 1
fi
