---
import type { FeedPage } from "../../../shared/feed";
interface Props {
  nav: FeedPage["nav"];
  user: FeedPage["user"];
}
const { nav, user } = Astro.props;
---

<header class="site-header">
  <a class="logo" href="/feed">InfraSupra Social</a>
  <nav class="site-nav" aria-label="Main">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
  </nav>
  <a class="me" href={`/u/${user.handle}`}>@{user.handle}</a>
</header>
