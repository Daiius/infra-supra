# 集計のサーバー（packages/stats）の環境変数の雛形。実値はリポジトリに書かない（.env は gitignore・Betterleaks が止める）。
# 本番は VPS の compose などで渡す。手順は prd/15 §7.1。

# 待ち受けのポート（リバースプロキシ・Vercel の中継の宛先がここへ届く）
PORT=4000

# Postgres（既存のサーバーの中の、集計用の DATABASE）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infra_supra
# 常駐のサーバーのロール（DML だけ: results への INSERT・SELECT）。パスワードは空のまま雛形に置き、実値は VPS の側だけに書く
DB_USER=infra_supra_server
DB_PASSWORD=
# 管理ロール（migrate.js だけが使う。DDL）
DB_ADMIN_USER=infra_supra_admin
DB_ADMIN_PASSWORD=

# ビルドの版（GET /api/version が返す。Dockerfile.prod のビルド引数で入る。手で置く必要はない）
# GIT_COMMIT=
# BUILD_TIME=
