# 常駐のサーバー（compose の stats）に渡す値。VPS で server.env に写して埋める（パーミッション 600）。
PORT=4000
DB_HOST=<Postgres のサービス名>
DB_PORT=5432
DB_NAME=infra_supra
DB_USER=infra_supra_server
DB_PASSWORD=

# 開始のトークンの置き場（D-174。VPS の既存の Redis を使う。ほかのアプリと混ざらないよう DB 番号を分ける。例は 3 番）。
# 本番（NODE_ENV=production）では無いと起動を止める。パスワードがあれば redis://:<パスワード>@<Redis のサービス名>:6379/3 の形。
# トークンは個人の情報を含まない（乱数と発行時刻だけ）ので、Redis の永続化（RDB・AOF）はどちらでもよい（失えば進行中のプレイが分布から漏れるだけ）。
REDIS_URL=redis://<Redis のサービス名>:6379/3
